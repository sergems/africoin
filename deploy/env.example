# Copy to /opt/africoin/.env on the Linode server and replace every placeholder.
# This file contains no real credentials and is safe to keep in source control.

NODE_ENV=production
HOST=0.0.0.0
APP_PORT=3000

MYSQL_DATABASE=africoin
MYSQL_USER=africoin
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Use a URL-encoded password if it contains special URL characters.
DATABASE_URL=mysql://africoin:replace-with-a-long-random-password@db:3306/africoin
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional Manus Forge services used by storage, notifications, maps, or image features.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional Vite build-time values. Only use a browser-safe frontend key here.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional one-time admin bootstrap values. Remove them after use.
ADMIN_EMAIL=
ADMIN_PASSWORD=

